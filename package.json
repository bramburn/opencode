{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter=@opencode/opencode dev",
    "build": "pnpm --parallel --filter \"@opencode/*\" build",
    "typecheck": "pnpm --parallel typecheck",
    "test": "pnpm --parallel test",
    "stainless": "./scripts/stainless",
    "postinstall": "node scripts/hooks.mjs"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "5.8.2",
      "@types/node": "22.13.9",
      "zod": "3.25.49",
      "ai": "5.0.0-beta.15"
    }
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "sst": "3.17.8",
    "typescript": "5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sst/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "sharp"
  ],
  "patchedDependencies": {
    "ai@4.3.16": "patches/ai@4.3.16.patch"
  },
  "dependencies": {
    "@hono/node-server": "^1.16.0",
    "minimatch": "^10.0.3"
  }
}
